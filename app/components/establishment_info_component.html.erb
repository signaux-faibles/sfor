<div>
    <div class="accompagnement__tab-title">
      <h3 class="fr-h2">Informations sur l'établissement</h3>
    </div>
    <div>
      <% if show_edit_button? %>
        <%= link_to 'Modifier les informations', edit_establishment_establishment_tracking_path(@establishment, @establishment_tracking), class: 'fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-edit-line fr-mb-2w' %>
      <% end %>
    </div>
    <dl class="sf-keyvalue-list">
      <dt class="sf-keyvalue-list__key">SIRET :</dt>
      <dd class="sf-keyvalue-list__value">
        <%= @establishment_tracking.establishment.siret %>
      </dd>
      <dt class="sf-keyvalue-list__key">Taille de l'entreprise : </dt>
      <dd class="sf-keyvalue-list__value">
        <button class="fr-btn--tooltip fr-btn" type="button" id="button-tracking-info-size" aria-describedby="tooltip-tracking-info-size">
          <span class="fr-icon-information-line" aria-hidden="true"></span>
          <span class="fr-sr-only">Information sur la taille de l'entreprise</span>
        </button>
        <span class="fr-tooltip fr-placement" id="tooltip-tracking-info-size" role="tooltip">
          La "taille de l'entreprise" indique la taille (par effectif et Chiffre d'affaires) du groupement auquel se rattache l'entreprise. Les statiques par "taille" permettent d'identifier les typologies d'entreprises accompagnées (filiale de groupe, PME, etc.). Retrouvez les définitions des "tailles" dans le guide utilisateur.
        </span>
        <%= @establishment_tracking.size&.name || 'Non renseigné' %>
      </dd>

      <dt class="sf-keyvalue-list__key">Effectif de l'établissement :</dt>
      <dd class="sf-keyvalue-list__value">
        <button class="fr-btn--tooltip fr-btn" type="button" id="button-tracking-info-effectif" aria-describedby="tooltip-tracking-info-effectif">
          <span class="fr-icon-information-line" aria-hidden="true"></span>
          <span class="fr-sr-only">Information sur l'effectif de l'établissement</span>
        </button>
        <span class="fr-tooltip fr-placement" id="tooltip-tracking-info-effectif" role="tooltip">
          L'effectif de l'établissement correspond au dernier effectif connu de l'établissement accompagné (donnée ACOSS, au niveau SIRET).
        </span>
        <%= establishment.latest_effectif.presence || 'Non renseigné' %>
      </dd>

      <dt class="sf-keyvalue-list__key">Filières : </dt>
      <dd class="sf-keyvalue-list__value">
        <button class="fr-btn--tooltip fr-btn" type="button" id="button-tracking-info-sectors" aria-describedby="tooltip-tracking-info-sectors">
          <span class="fr-icon-information-line" aria-hidden="true"></span>
          <span class="fr-sr-only">Information sur les filières</span>
        </button>
        <span class="fr-tooltip fr-placement" id="tooltip-tracking-info-sectors" role="tooltip">
          La "filière" indique la filière économique ou chaîne de valeur dans laquelle s'inscrit l'entreprise. Différente du code NAF qui définit le secteur d'activité. Les statistiques par "filière" permettent d'identifier les segments de l'économie fragilisés au niveau local et national.
        </span>
        <% if @establishment_tracking.sectors.any? %>
          <%= @establishment_tracking.sectors.map(&:name).join(', ') %>
        <% else %>
          Non renseigné
        <% end %>
      </dd>
    </dl>
</div>