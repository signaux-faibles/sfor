<div class="fr-notice fr-notice--info fr-mb-3w">
    <div class="fr-container">
        <div class="fr-notice__body">
            <p>
                <span class="fr-notice__title">Consultation de données hors de votre zone géographique :</span>
                <span class="fr-notice__desc">La consultation de données hors de votre zone géographique est autorisée uniquement dans le cadre de votre mission d’accompagnement des entreprises en difficulté. Toutes les consultations hors de votre zone géographique sont tracées et font l’objet de vérifications.</span>
            </p>
            <button title="Masquer le message" onclick="const notice = this.parentNode.parentNode.parentNode; notice.parentNode.removeChild(notice)" type="button" class="fr-btn--close fr-btn">Masquer le message</button>
        </div>
    </div>
</div>

<div class="fr-card sf-establishment-search">
  <%= form_with url: search_path, method: :get, scope: :search, class: "fr-search-bar", html: { class: "fr-search-bar__form", data: { view_toggle_target: "form", turbo: false } } do |f| %>
    <div class="fr-container--fluid fr-m-2w">
      <h2 class="fr-h4 fr-mt-1w">Rechercher un établissement ou une entreprise</h2>
      <div class="fr-grid-row fr-grid-row--gutters fr-mb-3w">
        <div class="fr-col-12 fr-col-xl-8">
          <p class="fr-text--sm">Les champs suivis d'un astérisque (*) sont obligatoires.</p>
          <div class="fr-input-group">
            <%= f.label :q, "Recherche par SIRET, SIREN ou raison sociale *", class: "fr-label" %>
            <div class="fr-input-wrap fr-icon-search-line">
              <%= f.text_field :q, value: search_params[:q], class: "fr-input", placeholder: "SIRET, SIREN ou raison sociale", required: true %>
            </div>
          </div>
        </div>
      </div>
      <div class="fr-grid-row fr-grid-row--gutters">
        <div class="fr-col-12 fr-col-md-6 fr-col-xl-4">
          <div class="fr-input-group">
            <%= f.label :tranche_effectif_salarie, "Effectif de l'entreprise", class: "fr-label" %>
            <%= f.select :tranche_effectif_salarie,
                         [
                           ["Tous", ""],
                           ["1 ou 2 salariés", "01"],
                           ["3 à 5 salariés", "02"],
                           ["6 à 9 salariés", "03"],
                           ["10 à 19 salariés", "11"],
                           ["20 à 49 salariés", "12"],
                           ["50 à 99 salariés", "21"],
                           ["100 à 199 salariés", "22"],
                           ["200 à 249 salariés", "31"],
                           ["250 à 499 salariés", "32"],
                           ["500 à 999 salariés", "41"],
                           ["1 000 à 1 999 salariés", "42"],
                           ["2 000 à 4 999 salariés", "51"],
                           ["5 000 à 9 999 salariés", "52"],
                           ["10 000 salariés et plus", "53"]
                         ],
                         { selected: search_params[:tranche_effectif_salarie] || "" },
                         {
                           class: "fr-select",
                         } %>
          </div>
        </div>
        <div class="fr-col-12 fr-col-md-6 fr-col-xl-4 sf-geo-search" data-controller="geo-search">
          <div class="fr-input-group">
            <%= f.label :cp_dep_label, "Zone géographique", class: "fr-label" %>
            <div class="fr-input-wrap fr-icon-map-pin-2-line">
              <%= f.text_field :cp_dep_label, 
                              value: search_params[:cp_dep_label], 
                              class: "fr-input", 
                              placeholder: "Ville, département, région...",
                              aria: {
                                 autocomplete: "both",
                                 controls: "sf-geo-search-list",
                                 expanded: "false",
                                 haspopup: "listbox",
                               },
                              role: "combobox",
                              data: { 
                                geo_search_target: "input",
                                action: "input->geo-search#search keydown->geo-search#handleKeydown"
                              },
                              autocomplete: "off"
              %>
            </div>
            <%= f.hidden_field :cp_dep_type, value: search_params[:cp_dep_type], data: { geo_search_target: "hiddenType" } %>
            <%= f.hidden_field :cp_dep, value: search_params[:cp_dep], data: { geo_search_target: "hiddenCode" } %>

            <div
              id="sf-geo-search-list"
              data-geo-search-target="results"
              class="sf-geo-search-results-container"
              role="listbox"
            >
          </div>
          </div>
        </div>
        <div class="fr-col-12 fr-col-md-6 fr-col-xl-4 sf-multiselect" data-controller="multiselect" data-multiselect-options-value="<%= @secteurs_activite_options.to_json %>" data-multiselect-label-value="Secteurs d'activité">
          <div class="fr-input-group">
            <%= f.label :section_activite_principale, "Secteurs d'activité", class: "fr-label" %>
            <div class="fr-input-wrap sf-multiselect-input-wrap" data-action="click->multiselect#focusInput">
              <div data-multiselect-target="tags" class="sf-multiselect-tags-container"></div>
              <%= f.text_field :section_activite_principale,
                              value: "",
                              class: "fr-input",
                              placeholder: "",
                              aria: {
                                autocomplete: "list",
                                controls: "sf-multiselect-activite-list",
                                expanded: "false",
                                haspopup: "listbox",
                              },
                              role: "combobox",
                              data: {
                                multiselect_target: "input",
                                action: "input->multiselect#search keydown->multiselect#handleKeydown focus->multiselect#handleFocus"
                              },
                              autocomplete: "off"
              %>
            </div>
            <%= f.hidden_field :section_activite_principale_values, value: @selected_sections_json, data: { multiselect_target: "hiddenValues" } %>

            <div
              id="sf-multiselect-activite-list"
              data-multiselect-target="results"
              class="sf-multiselect-results-container"
              role="listbox"
              aria-multiselectable="true"
            >
            </div>
          </div>
        </div>

      </div>

      <div class="fr-grid-row fr-grid-row--right fr-mt-5w">
        <ul class="fr-btns-group fr-btns-group--center fr-btns-group--inline-lg fr-btns-group--icon-left">
          <li>
            <%= link_to "Réinitialiser les filtres", home_path, class: "fr-btn fr-icon-restart-line fr-btn--secondary", data: { turbo: false} %>
          </li>
          <li>
            <%= f.submit "Rechercher", class: "fr-btn" %>
          </li>
        </ul>
      </div>
    </div>
  <% end %>
</div>
