<% content_for :title, "Connexion" %>

<div class="fr-pt-md-14v">
  <div class="fr-container fr-container--fluid fr-mb-md-14v">
    <div class="fr-grid-row fr-grid-row-gutters fr-grid-row--center">
      <div class="fr-col-12 fr-col-md-8 fr-col-lg-6">
        <div class="fr-container fr-background-alt--grey fr-px-md-0 fr-py-10v fr-py-md-14v">
          <div class="fr-grid-row fr-grid-row-gutters fr-grid-row--center">
            <div class="fr-col-12 fr-col-md-9 fr-col-lg-8">
              <div class="fr-notice fr-notice--info fr-mb-3w">
                <div class="fr-container">
                    <div class="fr-notice__body">
                        <p>
                            <span class="fr-notice__title"></span>
                            <span class="fr-notice__desc">Suite à des évolutions de l'application, nous vous invitons à <%= link_to "réinitialiser votre mot de passe", new_password_path(resource_name), class: "fr-notice__link" %> </span>
                        </p>
                        <button title="Masquer le message" onclick="const notice = this.parentNode.parentNode.parentNode; notice.parentNode.removeChild(notice)" type="button" class="fr-btn--close fr-btn">Masquer le message</button>
                    </div>
                </div>
              </div>
              <h1>Connexion à Signaux Faibles</h1>
              <p class="fr-text--sm"><%= t("two_factor.login_notice") %></p>

              <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "fr-mt-4w" }) do |f| %>
                <p class="fr-text--sm">Tous les champs sont obligatoires.</p>
                <%= render "shared/accessible_email_field",
                           form: f,
                           label: "Adresse électronique",
                           field_id: "user_email",
                           wrapper_class: "fr-mb-3w",
                           inline_error: flash[:sign_in_error],
                           html_options: { required: true } %>

                <%= render "shared/accessible_password_field",
                           form: f,
                           label: "Mot de passe",
                           field_id: "user_password",
                           purpose: :sign_in,
                           wrapper_class: "fr-mb-3w",
                           html_options: { required: true } %>

                <% if devise_mapping.rememberable? %>
                  <div class="fr-checkbox-group fr-mb-3w">
                    <%= f.check_box :remember_me, class: "fr-checkbox" %>
                    <%= f.label :remember_me, "Se souvenir de moi", class: "fr-label" %>
                  </div>
                <% end %>

                <div class="fr-btns-group">
                  <%= f.button "Se connecter", type: "submit", class: "fr-btn" %>
                </div>
              <% end %>

              <p class="fr-mt-4w">
                <%= link_to "Mot de passe oublié ?", new_password_path(resource_name), class: "fr-link" %>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
