<% if resource.errors[:base].any? %>
  <div class="fr-alert fr-alert--error fr-mb-2w" id="error_explanation" data-turbo-cache="false">
    <p class="fr-alert__title">
      <%= I18n.t("errors.messages.not_saved",
                 count: resource.errors[:base].count,
                 resource: resource.class.model_name.human.downcase)
       %>
    </p>
    <ul>
      <% resource.errors.full_messages_for(:base).each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
