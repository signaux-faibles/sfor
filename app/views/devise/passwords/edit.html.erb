<% content_for :title, "Réinitialisation de mot de passe" %>

<div class="fr-pt-md-14v">
  <div class="fr-container fr-container--fluid fr-mb-md-14v">
    <div class="fr-grid-row fr-grid-row-gutters fr-grid-row--center">
      <div class="fr-col-12 fr-col-md-8 fr-col-lg-6">
        <div class="fr-container fr-background-alt--grey fr-px-md-0 fr-py-10v fr-py-md-14v">
          <div class="fr-grid-row fr-grid-row-gutters fr-grid-row--center">
            <div class="fr-col-12 fr-col-md-9 fr-col-lg-8">
              <h1>Changer votre mot de passe</h1>

              <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "fr-mt-4w" }) do |f| %>
                <%= render "devise/shared/error_messages", resource: resource %>
                <%= f.hidden_field :reset_password_token %>

                <%= render "shared/accessible_password_field",
                           form: f,
                           label: "Nouveau mot de passe",
                           field_id: "user_password",
                           purpose: :new,
                           wrapper_class: "fr-mb-3w",
                           html_options: { autofocus: true, required: true } %>

                <%= render "shared/accessible_password_field",
                           form: f,
                           label: "Confirmer le nouveau mot de passe",
                           field_id: "user_password_confirmation",
                           attribute: :password_confirmation,
                           purpose: :confirmation,
                           wrapper_class: "fr-mb-3w",
                           html_options: { required: true } %>

                <div class="fr-btns-group">
                  <%= f.button "Changer mon mot de passe", type: "submit", class: "fr-btn" %>
                </div>
              <% end %>

              <p class="fr-mt-4w">
                <%= link_to "Retour à la connexion", new_session_path(resource_name), class: "fr-link" %>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
