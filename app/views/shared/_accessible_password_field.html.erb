<%#
  locals:
    form:         form builder
    label:        visible label text
    field_id:     unique HTML id for the input
    attribute:    :password or :password_confirmation (default :password)
    purpose:      :new, :sign_in or :confirmation (default :new)
    html_options: extra options passed to password_field (optional)
%>
<% field_id = local_assigns.fetch(:field_id) %>
<% attribute = local_assigns.fetch(:attribute, :password) %>
<% purpose = local_assigns.fetch(:purpose, :new) %>
<% html_options = local_assigns.fetch(:html_options, {}) %>
<% field_errors = form.object.errors[attribute] %>
<% input_classes = ["fr-input", html_options[:class], ("fr-input--error" if field_errors.any?)].compact.join(" ") %>
<% autocomplete = purpose == :sign_in ? "current-password" : "new-password" %>
<% extra_describedby = Array(local_assigns[:extra_describedby]) %>
<% aria_invalid = field_aria_invalid(form.object, attribute) %>
<% input_options = {
     id: field_id,
     class: input_classes,
     autocomplete: autocomplete,
     "aria-describedby": password_field_describedby(field_id, object: form.object, attribute: attribute, extra_ids: extra_describedby),
     "aria-invalid": aria_invalid
   } %>
<% input_options[:required] = true unless html_options.key?(:required) %>
<% input_options[:minlength] = password_minimum_length if purpose == :new %>

<div class="fr-input-group<%= " fr-input-group--error" if field_errors.any? %><%= " #{local_assigns[:wrapper_class]}" if local_assigns[:wrapper_class] %>">
  <%= form.label attribute, label, class: "fr-label", for: field_id %>
  <p id="<%= field_id %>-hint" class="fr-hint-text"><%= password_hint_for(purpose) %></p>
  <%= form.password_field attribute, input_options.deep_merge(html_options.except(:class)) %>
  <% if field_errors.any? %>
    <p id="<%= field_id %>-error" class="fr-error-text">
      <%= field_error_messages(form.object, attribute).join(", ") %>
    </p>
  <% end %>
</div>
