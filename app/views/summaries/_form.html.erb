<% if policy(@establishment_tracking).edit? %>
  <%
    summary_field_id = "summary-content-#{network.id}"
    summary_error_id = "#{summary_field_id}-error"
    has_summary_error = summary.errors[:content].any? || summary.errors[:network].any?
  %>
  <div class="fr-ml-3w">
    <%= form_with(model: [@establishment, @establishment_tracking, summary], local: false) do |form| %>
      <%= form.hidden_field :network_id, value: network.id, id:nil %>
      <div class="fr-input-group<%= ' fr-input-group--error' if has_summary_error %>">
        <%= form.label :content, "Contenu de la synthèse", for: summary_field_id %>
        <%= form.text_area :content,
                           class: "fr-input#{' fr-input--error' if has_summary_error}",
                           data: { controller: "auto-resize", action: "input->auto-resize#adjust" },
                           value: form.object.content.presence || "#### Contexte\n\n#### Difficultés\n\n#### Actions",
                           id: summary_field_id,
                           aria: {
                             invalid: (true if has_summary_error),
                             describedby: (summary_error_id if has_summary_error)
                           } %>

        <% if has_summary_error %>
          <p id="<%= summary_error_id %>" class="fr-error-text">
            <%= [
              *field_error_messages(summary, :content),
              *field_error_messages(summary, :network)
            ].join(", ") %>
          </p>
        <% end %>
      </div>
      <% if summary.persisted? %>
        <%= link_to "Annuler",
                    cancel_establishment_establishment_tracking_summary_path(@establishment, @establishment_tracking, summary),
                    class: "fr-btn fr-btn--secondary",
                    title: "Annuler la modification de la synthèse",
                    data: { turbo_stream: true, confirm: "Êtes-vous sûr de vouloir annuler ?" } %>
      <% end %>
      <%= form.submit "Sauvegarder",
                      class: "fr-btn fr-btn--primary",
                      title: "Sauvegarder la modification de la synthèse" %>
    <% end %>
  </div>
<% end %>
