<% content_for :title, "Nouvel accompagnement pour #{@establishment_tracking.establishment.raison_sociale}" %>

<%= form_with(model: [@establishment, @establishment_tracking], local: true, class: "edit_tracking") do |form| %>

  <div class="fr-container">
    <h1>Nouvel accompagnement pour <%= @establishment_tracking&.establishment&.raison_sociale %></h1>

    <div class="sf-fieldset-container">
      <fieldset class="fr-grid-row fr-fieldset">
        <legend class="fr-h2 fr-fieldset__legend--regular fr-fieldset__legend">Contributeurs de l'accompagnement</legend>
        <div class="fr-col-6">
          <% current_referent_ids = @establishment_tracking.referent_ids.map(&:to_s) %>

          <div class="fr-fieldset__element">
            <div class="fr-input-group">
              <div class="sf-multiselect" data-controller="multiselect" data-multiselect-options-value="<%= @users_options.to_json %>" data-multiselect-label-value="Référents">
                <div class="fr-label-wrapper">
                  <%= form.label :referent_ids_input, 'Référents', class: "fr-label" %>
                  <button class="fr-btn--tooltip fr-btn" type="button" id="button-new-tracking-referents" aria-describedby="tooltip-new-tracking-referents">
                    <span class="fr-icon-information-line" aria-hidden="true"></span>
                    <span class="fr-sr-only">Information sur les référents</span>
                  </button>
                </div>
                <span class="fr-tooltip fr-placement" id="tooltip-new-tracking-referents" role="tooltip">
                Le "référent" est la principale personne en charge l'accompagnement de l'entreprise.
                Il s'agit de l'interlocuteur le plus à même d'accompagner l'entreprise, conformément à la circulaire du 6 mars 2024.
                Plusieurs agents de différentes administrations peuvent être "référents" selon les problématiques et l'évolution du dossier.
                Les "référents" sont responsables de la mise à jour de la synthèse et sont les seuls à pouvoir modifier le statut. Le SP CODEFI dispose d'un droit de regard sur la synthèse dans le cadre de la rédaction du CR du CODEFI.
              </span>
                <div class="fr-input-wrap sf-multiselect-input-wrap" data-action="click->multiselect#focusInput">
                  <div data-multiselect-target="tags" class="sf-multiselect-tags-container"></div>
                  <%= form.text_field :referent_ids_input,
                                      value: "",
                                      class: "fr-input",
                                      placeholder: "",
                                      aria: { autocomplete: "list", controls: "sf-multiselect-referents-list", expanded: "false" },
                                      role: "combobox",
                                      data: { multiselect_target: "input", action: "input->multiselect#search keydown->multiselect#handleKeydown focus->multiselect#handleFocus" },
                                      autocomplete: "off" %>
                </div>
                <%= form.hidden_field :referent_ids_values,
                                      value: current_referent_ids.map { |id| { value: id, label: @users_options.find { |u| u[:value] == id }&.dig(:label).to_s } }.to_json,
                                      data: { multiselect_target: "hiddenValues" } %>
                <div id="sf-multiselect-referents-list" data-multiselect-target="results" class="sf-multiselect-results-container" role="listbox" aria-multiselectable="true"></div>
              </div>
              <% @establishment_tracking.errors[:referents].each do |error| %>
                <p class="fr-error-text"><%= error %></p>
              <% end %>
            </div>
          </div>

          <%
            current_participant_ids = @establishment_tracking.participant_ids.map(&:to_s)
          %>

          <div class="fr-fieldset__element">
            <div class="fr-input-group">
              <div class="sf-multiselect" data-controller="multiselect" data-multiselect-options-value="<%= @users_options.to_json %>" data-multiselect-label-value="Participants">
                <div class="fr-label-wrapper">
                  <%= form.label :participant_ids_input, 'Participants', class: "fr-label" %>
                  <button class="fr-btn--tooltip fr-btn" type="button" id="button-new-tracking-participants" aria-describedby="tooltip-new-tracking-participants">
                    <span class="fr-icon-information-line" aria-hidden="true"></span>
                    <span class="fr-sr-only">Information sur les participants</span>
                  </button>
                </div>
                <span class="fr-tooltip fr-placement" id="tooltip-new-tracking-participants" role="tooltip">
                Le "participant" a besoin de suivre l'accompagnement sans intervenir directement auprès de l'entreprise. Cela lui permet de partager des informations via l'ajout de commentaire et/ ou de suivre facilement le dossier via le filtre "mes accompagnements" en page d'accueil.
                Le SP CODEFI est "participant" dans chaque accompagnement issu de la liste de détection, ce qui ne l'empêchera pas d'être "référent" sur un certain nombre de dossiers.
                Il est possible d'ajouter en "participant" tout agent en dehors de votre zone géographique, après information du CODEFI.
              </span>
                <div class="fr-input-wrap sf-multiselect-input-wrap" data-action="click->multiselect#focusInput">
                  <div data-multiselect-target="tags" class="sf-multiselect-tags-container"></div>
                  <%= form.text_field :participant_ids_input,
                                      value: "",
                                      class: "fr-input",
                                      placeholder: "",
                                      aria: { autocomplete: "list", controls: "sf-multiselect-participants-list", expanded: "false" },
                                      role: "combobox",
                                      data: { multiselect_target: "input", action: "input->multiselect#search keydown->multiselect#handleKeydown focus->multiselect#handleFocus" },
                                      autocomplete: "off" %>
                </div>
                <%= form.hidden_field :participant_ids_values,
                                      value: current_participant_ids.map { |id| { value: id, label: @users_options.find { |u| u[:value] == id }&.dig(:label).to_s } }.to_json,
                                      data: { multiselect_target: "hiddenValues" } %>
                <div id="sf-multiselect-participants-list" data-multiselect-target="results" class="sf-multiselect-results-container" role="listbox" aria-multiselectable="true"></div>
              </div>
              <% @establishment_tracking.errors[:participants].each do |error| %>
                <p class="fr-error-text"><%= error %></p>
              <% end %>
            </div>
          </div>
        </div>
      </fieldset>
    </div>

    <div class="sf-fieldset-container">
      <fieldset class="fr-grid-row fr-fieldset">
        <legend class="fr-h2 fr-fieldset__legend--regular fr-fieldset__legend">Informations sur l'accompagnement</legend>
        <div class="fr-col-6">
          <div class="fr-fieldset__element">
            <div class="fr-input-group <%= 'fr-input-group--error' if @establishment_tracking.errors[:criticality_id].any? %>">
              <div class="fr-label-wrapper">
                <%= form.label :criticality_id, 'Criticité' %>
                <button class="fr-btn--tooltip fr-btn" type="button" id="button-new-tracking-criticality" aria-describedby="tooltip-new-tracking-criticality">
                  <span class="fr-icon-information-line" aria-hidden="true"></span>
                  <span class="fr-sr-only">Information sur la criticité</span>
                </button>
              </div>

              <div class="fr-tooltip fr-placement" id="tooltip-new-tracking-criticality" role="tooltip">
                La "criticité" définit la priorisation de traitement par le CODEFI de l'accompagnement, elle mesure l'urgence à agir en fonction du risque encouru par l'entreprise, des enjeux en termes stratégique ou d'emploi et de la sensibilité du dossier :
                <ul>
                  <li>La criticité "élevée" indique que l'entreprise nécessite une attention renforcée du CODEFI compte tenu de sa situation. Elle peut, entre autres, être confrontée à des risques élevés de défaillance à court terme et/ou sujette à des sensibilités politiques du fait de son intérêt stratégique.</li>
                  <li>La criticité "modérée" indique que l'entreprise rencontre une difficulté avérée qui n'entraîne pas un péril à court terme. Les difficultés sont néanmoins sérieuses et requièrent une attention particulière des membres du CODEFI.</li>
                  <li>Par défaut, les dossiers n'ont "pas de criticité". Cela indique une difficulté avérée de l'entreprise obligeant à son suivi régulier au sein du CODEFI, mais ne remettant pas en cause la pérennité de l'entreprise et des emplois.</li>
                </ul>
                L'agent "référent" est responsable de la définition de la criticité. En cas de suivi impliquant des agents de différentes administrations, la criticité est déterminée collégialement, en fonction de la priorité de l'entreprise pour le CODEFI.
              </div>
              <%= form.collection_select :criticality_id,
                                         Criticality.all,
                                         :id,
                                         :name,
                                         { selected: Criticality.find_by(name: "Pas de criticité")&.id },
                                         { class: 'fr-select' } %>
              <% @establishment_tracking.errors[:criticality_id].each do |error| %>
                <p class="fr-error-text"><%= error %></p>
              <% end %>
            </div>
          </div>

          <div class="fr-fieldset__element">
            <% current_label_ids = @establishment_tracking.tracking_label_ids.map(&:to_s) %>
            <div class="fr-input-group <%= 'fr-input-group--error' if @establishment_tracking.errors[:tracking_label_ids].any? %>">
              <div class="sf-multiselect" data-controller="multiselect" data-multiselect-options-value="<%= @labels_options.to_json %>" data-multiselect-label-value="Étiquettes">
                <div class="fr-label-wrapper">
                  <%= form.label :tracking_label_ids_input, 'Étiquettes', class: "fr-label" %>
                  <button class="fr-btn--tooltip fr-btn" type="button" id="button-new-tracking-labels" aria-describedby="tooltip-new-tracking-labels">
                    <span class="fr-icon-information-line" aria-hidden="true"></span>
                    <span class="fr-sr-only">Information sur les étiquettes</span>
                  </button>
                </div>

                <span class="fr-tooltip fr-placement" id="tooltip-new-tracking-labels" role="tooltip">
                Le champ "étiquettes" indique un élément de contexte ou un dispositif ponctuel ou prioritaire concernant le dossier.
              </span>
                <div class="fr-input-wrap sf-multiselect-input-wrap" data-action="click->multiselect#focusInput">
                  <div data-multiselect-target="tags" class="sf-multiselect-tags-container"></div>
                  <%= form.text_field :tracking_label_ids_input,
                                      value: "",
                                      class: "fr-input",
                                      placeholder: "",
                                      aria: { autocomplete: "list", controls: "sf-multiselect-labels-list", expanded: "false" },
                                      role: "combobox",
                                      data: { multiselect_target: "input", action: "input->multiselect#search keydown->multiselect#handleKeydown focus->multiselect#handleFocus" },
                                      autocomplete: "off" %>
                </div>
                <%= form.hidden_field :tracking_label_ids_values,
                                      value: current_label_ids.map { |id| { value: id, label: @labels_options.find { |o| o[:value] == id }&.dig(:label).to_s } }.to_json,
                                      data: { multiselect_target: "hiddenValues" } %>
                <div id="sf-multiselect-labels-list" data-multiselect-target="results" class="sf-multiselect-results-container" role="listbox" aria-multiselectable="true"></div>
              </div>
              <% @establishment_tracking.errors[:tracking_label_ids].each do |error| %>
                <p class="fr-error-text"><%= error %></p>
              <% end %>
            </div>
          </div>

          <div class="fr-fieldset__element">
            <% current_supporting_service_ids = @establishment_tracking.supporting_service_ids.map(&:to_s) %>
            <div class="fr-input-group <%= 'fr-input-group--error' if @establishment_tracking.errors[:supporting_service_ids].any? %>">
              <div class="sf-multiselect" data-controller="multiselect" data-multiselect-options-value="<%= @supporting_services_options.to_json %>" data-multiselect-label-value="Instances concernées">
                <div class="fr-label-wrapper">
                  <%= form.label :supporting_service_ids_input, 'Instances concernées', class: "fr-label" %>
                  <button class="fr-btn--tooltip fr-btn" type="button" id="button-new-tracking-supporting-service" aria-describedby="tooltip-new-tracking-supporting-service">
                    <span class="fr-icon-information-line" aria-hidden="true"></span>
                    <span class="fr-sr-only">Information sur les instances concernées</span>
                  </button>
                </div>
                <span class="fr-tooltip fr-placement" id="tooltip-new-tracking-supporting-service" role="tooltip">
                Le champ "instances concernées" indique les parties prenantes concernées par le dossier.
              </span>
                <div class="fr-input-wrap sf-multiselect-input-wrap" data-action="click->multiselect#focusInput">
                  <div data-multiselect-target="tags" class="sf-multiselect-tags-container"></div>
                  <%= form.text_field :supporting_service_ids_input,
                                      value: "",
                                      class: "fr-input",
                                      placeholder: "",
                                      aria: { autocomplete: "list", controls: "sf-multiselect-supporting-services-list", expanded: "false" },
                                      role: "combobox",
                                      data: { multiselect_target: "input", action: "input->multiselect#search keydown->multiselect#handleKeydown focus->multiselect#handleFocus" },
                                      autocomplete: "off" %>
                </div>
                <%= form.hidden_field :supporting_service_ids_values,
                                      value: current_supporting_service_ids.map { |id| { value: id, label: @supporting_services_options.find { |o| o[:value] == id }&.dig(:label).to_s } }.to_json,
                                      data: { multiselect_target: "hiddenValues" } %>
                <div id="sf-multiselect-supporting-services-list" data-multiselect-target="results" class="sf-multiselect-results-container" role="listbox" aria-multiselectable="true"></div>
              </div>
              <% @establishment_tracking.errors[:supporting_service_ids].each do |error| %>
                <p class="fr-error-text"><%= error %></p>
              <% end %>
            </div>
          </div>

          <div class="fr-fieldset__element">
            <% current_difficulty_ids = @establishment_tracking.difficulty_ids.map(&:to_s) %>
            <div class="fr-input-group <%= 'fr-input-group--error' if @establishment_tracking.errors[:difficulty_ids].any? %>">
              <div class="sf-multiselect" data-controller="multiselect" data-multiselect-options-value="<%= @difficulties_options.to_json %>" data-multiselect-label-value="Difficultés">
                <div class="fr-label-wrapper">
                  <%= form.label :difficulty_ids_input, 'Difficultés', class: "fr-label" %>
                  <button class="fr-btn--tooltip fr-btn" type="button" id="button-new-tracking-difficulty" aria-describedby="tooltip-new-tracking-difficulty">
                    <span class="fr-icon-information-line" aria-hidden="true"></span>
                    <span class="fr-sr-only">Information sur les difficultés</span>
                  </button>
                </div>
                <span class="fr-tooltip fr-placement" id="tooltip-new-tracking-difficulty" role="tooltip">
                Ce champ indique les difficultés rencontrées par les entreprises qu'elles soient les sources premières ou les conséquences de difficultés préexistantes. Par exemple, une entreprise avec des besoins de trésorerie peut également avoir été victime d'un aléa climatique à l'origine de ses problèmes de trésorerie.
              </span>
                <div class="fr-input-wrap sf-multiselect-input-wrap" data-action="click->multiselect#focusInput">
                  <div data-multiselect-target="tags" class="sf-multiselect-tags-container"></div>
                  <%= form.text_field :difficulty_ids_input,
                                      value: "",
                                      class: "fr-input",
                                      placeholder: "",
                                      aria: { autocomplete: "list", controls: "sf-multiselect-difficulties-list", expanded: "false" },
                                      role: "combobox",
                                      data: { multiselect_target: "input", action: "input->multiselect#search keydown->multiselect#handleKeydown focus->multiselect#handleFocus" },
                                      autocomplete: "off" %>
                </div>
                <%= form.hidden_field :difficulty_ids_values,
                                      value: current_difficulty_ids.map { |id| { value: id, label: @difficulties_options.find { |o| o[:value] == id }&.dig(:label).to_s } }.to_json,
                                      data: { multiselect_target: "hiddenValues" } %>
                <div id="sf-multiselect-difficulties-list" data-multiselect-target="results" class="sf-multiselect-results-container" role="listbox" aria-multiselectable="true"></div>
              </div>
              <% @establishment_tracking.errors[:difficulty_ids].each do |error| %>
                <p class="fr-error-text"><%= error %></p>
              <% end %>
            </div>
          </div>

          <div class="fr-fieldset__element">
            <% current_user_action_ids = @establishment_tracking.user_action_ids.map(&:to_s) %>
            <div class="fr-input-group <%= 'fr-input-group--error' if @establishment_tracking.errors[:user_action_ids].any? %>">
              <div class="sf-multiselect" data-controller="multiselect" data-multiselect-options-value="<%= @user_actions_options.to_json %>" data-multiselect-label-value="Actions réalisées">
                <div class="fr-label-wrapper">
                  <%= form.label :user_action_ids_input, 'Actions réalisées', class: "fr-label" %>
                  <button class="fr-btn--tooltip fr-btn" type="button" id="button-new-tracking-user-action" aria-describedby="tooltip-new-tracking-user-action">
                    <span class="fr-icon-information-line" aria-hidden="true"></span>
                    <span class="fr-sr-only">Information sur les actions réalisées</span>
                  </button>
                </div>
                <span class="fr-tooltip fr-placement" id="tooltip-new-tracking-user-action" role="tooltip">
                Ce champ précise les actions réellement mises en œuvre par l'agent ou le CODEFI. Il est à remplir une fois les actions réalisées, au cours ou à la clôture de l'accompagnement.
              </span>
                <div class="fr-input-wrap sf-multiselect-input-wrap" data-action="click->multiselect#focusInput">
                  <div data-multiselect-target="tags" class="sf-multiselect-tags-container"></div>
                  <%= form.text_field :user_action_ids_input,
                                      value: "",
                                      class: "fr-input",
                                      placeholder: "",
                                      aria: { autocomplete: "list", controls: "sf-multiselect-user-actions-list", expanded: "false" },
                                      role: "combobox",
                                      data: { multiselect_target: "input", action: "input->multiselect#search keydown->multiselect#handleKeydown focus->multiselect#handleFocus" },
                                      autocomplete: "off" %>
                </div>
                <%= form.hidden_field :user_action_ids_values,
                                      value: current_user_action_ids.map { |id| { value: id, label: @user_actions_options.find { |o| o[:value] == id }&.dig(:label).to_s } }.to_json,
                                      data: { multiselect_target: "hiddenValues" } %>
                <div id="sf-multiselect-user-actions-list" data-multiselect-target="results" class="sf-multiselect-results-container" role="listbox" aria-multiselectable="true"></div>
              </div>
              <% @establishment_tracking.errors[:user_action_ids].each do |error| %>
                <p class="fr-error-text"><%= error %></p>
              <% end %>
            </div>
          </div>

          <div class="fr-fielset__element">
            <% current_codefi_redirect_ids = @establishment_tracking.codefi_redirect_ids.map(&:to_s) %>
            <div class="fr-input-group <%= 'fr-input-group--error' if @establishment_tracking.errors[:codefi_redirect_ids].any? %>">
              <div class="sf-multiselect" data-controller="multiselect" data-multiselect-options-value="<%= @codefi_redirects_options.to_json %>" data-multiselect-label-value="Réorientations hors CODEFI">
                <div class="fr-label-wrapper">
                  <%= form.label :codefi_redirect_ids_input, 'Réorientations hors CODEFI', class: "fr-label" %>
                  <button class="fr-btn--tooltip fr-btn" type="button" id="button-new-tracking-codefi-redirect" aria-describedby="tooltip-new-tracking-codefi-redirect">
                    <span class="fr-icon-information-line" aria-hidden="true"></span>
                    <span class="fr-sr-only">Information sur la réorientation hors CODEFI</span>
                  </button>
                </div>
                <span class="fr-tooltip fr-placement" id="tooltip-new-tracking-codefi-redirect" role="tooltip">
                Ce champ précise les acteurs ne relevant pas du CODEFI, internes ou externes à l'administration, vers lesquels l'entreprise a été redirigée.
              </span>
                <div class="fr-input-wrap sf-multiselect-input-wrap" data-action="click->multiselect#focusInput">
                  <div data-multiselect-target="tags" class="sf-multiselect-tags-container"></div>
                  <%= form.text_field :codefi_redirect_ids_input,
                                      value: "",
                                      class: "fr-input",
                                      placeholder: "",
                                      aria: { autocomplete: "list", controls: "sf-multiselect-codefi-redirects-list", expanded: "false" },
                                      role: "combobox",
                                      data: { multiselect_target: "input", action: "input->multiselect#search keydown->multiselect#handleKeydown focus->multiselect#handleFocus" },
                                      autocomplete: "off" %>
                </div>
                <%= form.hidden_field :codefi_redirect_ids_values,
                                      value: current_codefi_redirect_ids.map { |id| { value: id, label: @codefi_redirects_options.find { |o| o[:value] == id }&.dig(:label).to_s } }.to_json,
                                      data: { multiselect_target: "hiddenValues" } %>
                <div id="sf-multiselect-codefi-redirects-list" data-multiselect-target="results" class="sf-multiselect-results-container" role="listbox" aria-multiselectable="true"></div>
              </div>
              <% @establishment_tracking.errors[:codefi_redirect_ids].each do |error| %>
                <p class="fr-error-text"><%= error %></p>
              <% end %>
            </div>
          </div>
        </div>
      </fieldset>
    </div>

    <div class="sf-fieldset-container">
      <fieldset class="fr-grid-row fr-fieldset">
        <legend class="fr-h2 fr-fieldset__legend--regular fr-fieldset__legend">Informations sur l'établissement</legend>
        <div class="fr-col-6">

          <div class="fr-fieldset__element">
            <p class="fr-m-0"><strong>SIRET</strong></p>

            <p><%= @establishment_tracking.establishment.siret %></p>
          </div>

          <div class="fr-fieldset__element">
            <% current_sector_ids = @establishment_tracking.sector_ids.map(&:to_s) %>
            <div class="fr-input-group <%= 'fr-input-group--error' if @establishment_tracking.errors[:sector_ids].any? %>">
              <div class="sf-multiselect" data-controller="multiselect" data-multiselect-options-value="<%= @sectors_options.to_json %>" data-multiselect-label-value="Filières">
                <div class="fr-label-wrapper">
                  <%= form.label :sector_ids_input, 'Filières', class: "fr-label" %>
                  <button class="fr-btn--tooltip fr-btn" type="button" id="button-new-tracking-sector" aria-describedby="tooltip-new-tracking-sector">
                    <span class="fr-icon-information-line" aria-hidden="true"></span>
                    <span class="fr-sr-only">Information sur les filières</span>
                  </button>
                </div>
                <span class="fr-tooltip fr-placement" id="tooltip-new-tracking-sector" role="tooltip">
                La "filière" indique la filière économique ou chaîne de valeur dans laquelle s'inscrit l'entreprise. Différente du code NAF qui définit le secteur d'activité. Les statistiques par "filière" permettent d'identifier les segments de l'économie fragilisés au niveau local et national.
              </span>
                <div class="fr-input-wrap sf-multiselect-input-wrap" data-action="click->multiselect#focusInput">
                  <div data-multiselect-target="tags" class="sf-multiselect-tags-container"></div>
                  <%= form.text_field :sector_ids_input,
                                      value: "",
                                      class: "fr-input",
                                      placeholder: "",
                                      aria: { autocomplete: "list", controls: "sf-multiselect-sectors-list", expanded: "false" },
                                      role: "combobox",
                                      data: { multiselect_target: "input", action: "input->multiselect#search keydown->multiselect#handleKeydown focus->multiselect#handleFocus" },
                                      autocomplete: "off" %>
                </div>
                <%= form.hidden_field :sector_ids_values,
                                      value: current_sector_ids.map { |id| { value: id, label: @sectors_options.find { |o| o[:value] == id }&.dig(:label).to_s } }.to_json,
                                      data: { multiselect_target: "hiddenValues" } %>
                <div id="sf-multiselect-sectors-list" data-multiselect-target="results" class="sf-multiselect-results-container" role="listbox" aria-multiselectable="true"></div>
              </div>
              <% @establishment_tracking.errors[:sector_ids].each do |error| %>
                <p class="fr-error-text"><%= error %></p>
              <% end %>
            </div>
          </div>
        </div>
      </fieldset>
    </div>

    <div class="fr-grid-row fr-grid-row--left fr-mb-3w">
      <div class="fr-col-6">
        <div class="">
          <ul class="fr-btns-group fr-btns-group--inline-md">
            <li>
              <%= form.submit "Créer l'accompagnement", class: 'fr-btn' %>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
<% end %>


