<!DOCTYPE html>
<html lang="fr">
<head>
  <title><%= content_for?(:title) ? "#{yield(:title)} — " : "" %>Signaux Faibles</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

  <%= render "layouts/sentry" %>

  <%= javascript_importmap_tags %>
  <meta name="turbo-prefetch" content="false">
</head>

<body>
<div id="page-start" tabindex="-1" data-controller="initial-focus" class="fr-sr-only">Début de la page</div>

<!-- In some circumstances, Devise adds a :timedout key to the flash hash, which is not meant for display. Remove this key from the hash if you intend to print the entire hash. -->
<div id="flash" class="fr-container">
  <%= render "layouts/flash_messages", margin: true %>
</div>

<main role="main" id="content">
  <%= yield %>
</main>

</body>
</html>

