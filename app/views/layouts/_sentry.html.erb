<% sentry_dsn = ENV["SENTRY_DSN"].presence %>
<% if sentry_dsn %>
  <% sentry_debug = Rails.env.development? %>
  <% sentry_environment = ENV["SENTRY_ENV"].presence || Rails.env %>
  <script
    src="https://browser.sentry-cdn.com/8.47.0/bundle.tracing.min.js"
    integrity="sha384-wYec/atCKBIhxMeAqO4JgQzLgv7nPphrOELh1UduVUFqt5DXn0Ey8pqiYEyYvZZ3"
    crossorigin="anonymous"
  ></script>
  <%# Use raw JSON in <script> — ERB escaping turns quotes into &quot; and breaks Sentry.init %>
  <script>
    (function () {
      if (typeof Sentry === "undefined") {
        console.error("[Sentry] bundle.tracing.min.js failed to load");
        return;
      }

      Sentry.init({
        dsn: <%== sentry_dsn.to_json %>,
        environment: <%== sentry_environment.to_json %>,
        debug: <%= sentry_debug %>,
        integrations: [
          Sentry.browserTracingIntegration({
            beforeStartSpan: function (context) {
              return Object.assign({}, context, {
                name: window.location.pathname
                  .replace(/\/[a-f0-9-]{36}/gi, "/<id>")
                  .replace(/\/\d+/g, "/<id>"),
              });
            },
          }),
        ],
        tracesSampleRate: 1.0,
        tracePropagationTargets: [window.location.origin],
      });

      <% if local_assigns.fetch(:identify_user, false) && user_signed_in? %>
      Sentry.setUser({ email: <%== current_user.email.to_json %> });
      <% end %>

      <% if sentry_debug %>
      console.info("[Sentry] initialized for", <%== sentry_environment.to_json %>);
      <% end %>
    })();
  </script>
<% end %>
