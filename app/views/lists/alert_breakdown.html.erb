<%= turbo_frame_tag "alert_breakdown" do %>
  <%= pluralize(@total_count, "entreprise", "entreprises") %> résultat<%= "s" if @total_count > 1 %>
  <% if @alert_breakdown %>
    <% badges = [] %>
    <% elevee_count = @alert_breakdown[:alerte_elevee].to_i %>
    <% if elevee_count > 0 %>
      <% badges << capture do %>
        <span class="fr-badge fr-badge--error fr-badge--no-icon">
          <%= elevee_count %> <%= elevee_count > 1 ? "Alertes élevées" : "Alerte élevée" %>
        </span>
      <% end %>
    <% end %>
    <% moderee_count = @alert_breakdown[:alerte_moderee].to_i %>
    <% if moderee_count > 0 %>
      <% badges << capture do %>
        <span class="fr-badge fr-badge--yellow-tournesol">
          <%= moderee_count %> <%= moderee_count > 1 ? "Alertes modérées" : "Alerte modérée" %>
        </span>
      <% end %>
    <% end %>
    <% if current_user&.crp_network_member? %>
      <% plans_count = @alert_breakdown[:alerte_plans].to_i %>
      <% if plans_count > 0 %>
        <% badges << capture do %>
          <span class="fr-badge fr-badge--info fr-badge--no-icon">
            <%= plans_count %> <%= plans_count > 1 ? "Plans" : "Plan" %>
          </span>
        <% end %>
      <% end %>
      <% ratios_count = @alert_breakdown[:alerte_ratios].to_i %>
      <% if ratios_count > 0 %>
        <% badges << capture do %>
          <span class="fr-badge fr-badge--warning fr-badge--no-icon">
            <%= ratios_count %> <%= ratios_count > 1 ? "Ratios" : "Ratio" %>
          </span>
        <% end %>
      <% end %>
    <% end %>
    <% if badges.any? %>
      • <%= safe_join(badges, " et ").html_safe %>
    <% end %>
  <% end %>
<% end %>
