<% content_for :title, "Notifications" %>

<div class="fr-container fr-mt-2w fr-mb-5w">
  <div class="grid-row">
    <h1>Notifications</h1>
  </div>

  <% if @notifications.any? %>
    <div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
      <% @notifications.each do |notification| %>
        <% read_at = @notification_reads[notification.id]&.read_at %>
        <ol class="fr-col-12">
          <li class="fr-card fr-card--no-arrow fr-mb-2w">
            <div class="fr-card__body">
              <div class="fr-card__content">
                <p class="fr-card__title">
                  <%= link_to notification.title, notification_path(notification), class: "fr-link" %>
                  <% if read_at.blank? %>
                    <span class="fr-badge fr-badge--new fr-ml-1w">Nouveau</span>
                  <% end %>
                </p>
                <p class="fr-card__desc">
                  <%= l(notification.created_at.to_date) %>
                  <% if read_at.present? %>
                    · Lu le <%= l(read_at.to_date) %>
                  <% end %>
                </p>
              </div>
              
            </div>
          </li>
        </ol>
      <% end %>
    </div>
  <% else %>
    <p>Aucune notification disponible.</p>
  <% end %>
</div>
