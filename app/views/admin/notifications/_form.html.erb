<%= form_with model: [:admin, @notification], local: true, class: "fr-mb-3w" do |form| %>
  <% if @notification.errors.any? %>
    <div class="fr-alert fr-alert--error fr-mb-2w">
      <p class="fr-alert__title"><%= pluralize(@notification.errors.count, "erreur") %> ont empêché l'enregistrement :</p>
      <ul>
        <% @notification.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="fr-input-group fr-mb-2w" style="max-width: 640px;">
    <%= form.label :title, "Titre", class: "fr-label" %>
    <%= form.text_field :title, class: "fr-input" %>
  </div>

  <div class="fr-input-group fr-mb-2w" style="max-width: 640px;">
    <%= form.label :body, "Contenu", class: "fr-label" %>
    <%= form.text_area :body, class: "fr-input", rows: 6 %>
  </div>

  <div class="fr-select-group fr-mb-2w" style="max-width: 420px;">
    <%= form.label :show_as_flash, "Afficher en flash", class: "fr-label" %>
    <%= form.select :show_as_flash,
                    [["Aucun", nil], ["Succès", "success"], ["Erreur", "error"], ["Information", "information"], ["Avertissement", "warning"]],
                    {}, class: "fr-select" %>
  </div>

  <fieldset class="fr-fieldset fr-mb-2w">
    <legend class="fr-fieldset__legend">Segments</legend>
    <%= form.collection_check_boxes :segment_ids, @segments, :id, :name do |segment| %>
      <div class="fr-checkbox-group">
        <%= segment.check_box %>
        <%= segment.label class: "fr-label" %>
      </div>
    <% end %>
  </fieldset>

  <div class="fr-btns-group fr-btns-group--inline">
    <%= form.submit class: "fr-btn fr-btn--sm" %>
    <%= link_to "Annuler", admin_notifications_path, class: "fr-btn fr-btn--sm fr-btn--secondary" %>
  </div>
<% end %>
