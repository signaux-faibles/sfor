DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
SENTRY_DSN=
SENTRY_ENV=
SENTRY_CONTAINER_ROLE=
METABASE_SITE_URL=
METABASE_SECRET_KEY=

# API Entreprise conf
API_ENTREPRISES_TOKEN=
API_ENTREPRISES_RECIPIENT=

# OpenSignauxFaibles conf
OSF_DATABASE_HOST=
OSF_DATABASE_PORT=
OSF_DATABASE_NAME=
OSF_DATABASE_USERNAME=
OSF_DATABASE_PASSWORD=
OSF_DATABASE_POOL=

# PaperTrail Configuration
PAPERTRAIL_ENABLED=true
PAPERTRAIL_MAX_VERSIONS=1000

# SMTP conf
SMTP_ADDRESS=
SMTP_PORT=

# For letter opener to work in local env (known issue)
BROWSER=/dev/null

# Active Record encryption (required in production for TOTP secrets)
# Generate with: docker compose run --rm web rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
